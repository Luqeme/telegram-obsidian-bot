# Пример конфигурации nginx для дашборда.
#
# SECRET — случайная строка (32 hex-символа). Тот же путь должен попасть
# в DASHBOARD_URL у бота: https://dash.example.ru/webapp/SECRET/
#
# Смысл: наружу отвечает только этот путь. Всё остальное — 404 без названий,
# чтобы сканеры и случайные прохожие не видели даже оболочку дашборда.

server {
    listen 80;
    listen [::]:80;
    server_name dash.example.ru;

    # Let's Encrypt должен дотянуться до проверки, иначе не продлится сертификат
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name dash.example.ru;

    ssl_certificate /etc/letsencrypt/live/dash.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dash.example.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;

    location = /webapp/SECRET {
        return 301 /webapp/SECRET/;
    }

    # Единственный публичный путь. Слэш на конце proxy_pass срезает префикс:
    # /webapp/SECRET/api/today превращается в /api/today для приложения.
    location /webapp/SECRET/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        default_type text/plain;
        return 404 "Not Found";
    }
}
