# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# через запятую, без пробелов (пробелы парсер срежет)
ALLOWED_TELEGRAM_USERS=123456789,987654321

# ── Groq ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ── GitHub ───────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=username/my-obsidian-vault
GITHUB_BRANCH=main
OBSIDIAN_INBOX_DIR=00_Inbox

# ── Прочее ───────────────────────────────────────────────
TIMEZONE=Asia/Yekaterinburg
LOG_LEVEL=INFO
MAX_AUDIO_MB=20
# true — имена файлов латиницей (oplatit-internet), false — кириллицей (оплатить-интернет)
FILENAME_TRANSLITERATE=true
# утренний дайджест в HH:MM по TIMEZONE; пусто — не присылать
DIGEST_TIME=09:00
# воскресный пинг инбокса в HH:MM; пусто — не присылать
WEEKLY_PING_TIME=10:00
